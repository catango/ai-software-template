#!/usr/bin/env python3
"""Install engine entry point. Run as: python3 -I toolchain/install check|list|install|verify

The manifest is toolchain/ci-manifest.toml (exact versions, an artifact and SHA-256 for every declared architecture).
"""
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from toolchain_engine.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
