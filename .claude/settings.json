{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": false,
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh api */merge*)",
      "Bash(gh api */reviews*)",
      "Bash(gh api *mergePullRequest*)",
      "Bash(gh api *addPullRequestReview*)",
      "Bash(gh api *enablePullRequestAutoMerge*)",
      "Bash(gh repo create *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo archive *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh ruleset *)",
      "Bash(gh api */rulesets*)",
      "Bash(gh api */branches/*/protection*)",
      "Bash(gh api */actions/secrets*)",
      "Bash(gh api */actions/variables*)",
      "Bash(gh api */actions/permissions*)",
      "Bash(gh api */dependabot/secrets*)",
      "Bash(gh api */environments*)",
      "Bash(gh api */collaborators*)",
      "Bash(gh api */invitations*)",
      "Bash(gh api */hooks*)",
      "Bash(gh api */keys*)",
      "Bash(gh api */transfer*)",
      "Bash(gh api *-X*DELETE*)",
      "Bash(gh api *--method*DELETE*)",
      "Bash(gh api */git/refs*)",
      "Bash(gh api */releases*)",
      "Bash(gh release create *)",
      "Bash(gh release delete *)",
      "Bash(gh auth *)",
      "Read(~/.config/gh/**)",
      "Bash(* ~/.config/gh/*)",
      "Bash(* $HOME/.config/gh/*)",
      "Bash(* ${HOME}/.config/gh/*)",
      "Bash(* */.config/gh/*)",
      "Bash(git push * main)",
      "Bash(git push * main:*)",
      "Bash(git push * HEAD:main)",
      "Bash(git push * main *)",
      "Bash(git push *:main*)",
      "Bash(git push *:refs/heads/main*)",
      "Bash(git push * refs/heads/main*)",
      "Bash(git push * master)",
      "Bash(git push * master *)",
      "Bash(git push *:master*)",
      "Bash(git push *:refs/heads/master*)",
      "Bash(git push * refs/heads/master*)",
      "Bash(git push * +*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push --tags*)",
      "Bash(git push * --tags*)",
      "Bash(git tag *)",
      "Bash(sudo *)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(declare -x*)",
      "Bash(export -p*)",
      "Bash(set)",
      "Bash(printenv*)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(rsync *)",
      "Bash(ssh-keygen *)",
      "Bash(ssh-add *)",
      "Bash(ssh-agent *)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Bash(* ~/.ssh/*)",
      "Bash(* $HOME/.ssh/*)",
      "Bash(* ${HOME}/.ssh/*)",
      "Bash(* */.ssh/*)"
    ],
    "ask": [
      "Bash(gh api *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(pip install *)",
      "Bash(uv tool install *)",
      "Bash(npm install *)",
      "WebFetch"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(rg *)",
      "Bash(fd *)"
    ]
  }
}
