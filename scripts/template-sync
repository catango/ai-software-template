#!/usr/bin/env python3
"""Bring this repository up to a release of the template it was generated from. See scripts/lib/template_sync/cli.py for the details.

    scripts/template-sync [--to] v<MAJOR>.<MINOR>.<PATCH> [--dry-run] [--fixture DIR]
    scripts/template-sync --check [--fixture DIR]

--check prints the template lag as its first line and writes nothing. --fixture DIR reads the template from the local repository
DIR/<owner>/<name> and pushes nothing (the tests use it). The source of the template is the one recorded in .template/state.toml.
"""
import os
import sys

sys.dont_write_bytecode = True
here = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, here)
sys.path.insert(0, os.path.join(here, "lib"))

from template_sync import cli  # noqa: E402

if __name__ == "__main__":
    sys.exit(cli.main(sys.argv[1:]))
